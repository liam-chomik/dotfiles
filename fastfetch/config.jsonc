// ~/.config/fastfetch/config.jsonc

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "padding": {
      "top": 1,
      "right": 4
    }
  },

  "display": {
    // Gruvbox Material yellow (#D8A657) for keys, blue (#7DAEA3) for the title.
    "color": {
      "keys": "yellow",
      "title": "blue"
    },
    "separator": ": "
  },

  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "locale",
    "break",
    "colors"
  ]
}
